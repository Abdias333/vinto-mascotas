# ---- Base de datos (PostgreSQL) ----
POSTGRES_USER=vinto
POSTGRES_PASSWORD=vinto123
POSTGRES_DB=vinto_mascotas
POSTGRES_HOST=localhost
# 5433 = contenedor de docker-compose (evita chocar con un Postgres local en 5432)
POSTGRES_PORT=5433
# Opcional: si se define, tiene prioridad sobre las variables de arriba
# DATABASE_URL=postgresql+psycopg2://vinto:vinto123@localhost:5433/vinto_mascotas

# ---- Aplicación ----
APP_PORT=8080
STORAGE_SECRET=cambia-esta-clave-por-algo-largo-y-aleatorio
MEDIA_DIR=media

# ---- Administrador inicial (se crea al arrancar si no existe) ----
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@vinto.bo
ADMIN_PASSWORD=Admin12345

# ---- Mapa / negocio ----
CENTRO_LAT=-17.3917
CENTRO_LON=-66.3167
RADIO_KM_DEFECTO=1.0
ZONAS=Vinto Centro,Vinto Norte,Vinto Sur,Vinto Este,Vinto Oeste

# ---- Geocodificación (OpenStreetMap Nominatim) ----
GEOCODER_USER_AGENT=vinto-mascotas/1.0 (taller-programacion-uab)
